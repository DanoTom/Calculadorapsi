---
/**
 * Pie de página: descripción, navegación secundaria, legales y disclaimer.
 */
import Logo from './Logo.astro';
import { T } from '../../lib/strings';

const anio = new Date().getFullYear();

const secciones = [
  { href: '/#calculadora', texto: T.nav.calculadora },
  { href: '/guias', texto: T.nav.guias },
  { href: '/metodologia', texto: 'Cómo calcula' },
  { href: '/sobre', texto: T.nav.sobre },
  { href: '/rss.xml', texto: 'Feed RSS' },
];
const legal = [
  { href: '/privacidad', texto: T.nav.privacidad },
  { href: '/terminos', texto: 'Términos de uso' },
  { href: '/contacto', texto: 'Contacto' },
];
---

<footer class="mt-20 border-t border-crema-200 bg-crema-100/50">
  <div class="contenedor py-12">
    <div class="grid gap-10 md:grid-cols-[1.5fr_1fr_1fr]">
      <div class="max-w-sm">
        <Logo />
        <p class="mt-4 text-sm leading-relaxed text-tinta-600">
          {T.footer.descripcion}
        </p>
      </div>

      <div>
        <h2 class="font-display text-sm font-semibold text-tinta-900">{T.footer.secciones}</h2>
        <ul class="mt-3 space-y-2">
          {
            secciones.map((l) => (
              <li>
                <a href={l.href} class="text-sm text-tinta-600 transition-colors hover:text-terracota-600">
                  {l.texto}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="font-display text-sm font-semibold text-tinta-900">{T.footer.legal}</h2>
        <ul class="mt-3 space-y-2">
          {
            legal.map((l) => (
              <li>
                <a href={l.href} class="text-sm text-tinta-600 transition-colors hover:text-terracota-600">
                  {l.texto}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="mt-10 border-t border-crema-200 pt-6">
      <p class="text-xs leading-relaxed text-tinta-500">{T.footer.derechos}</p>
      <p class="mt-2 text-xs text-tinta-500">
        © {anio} {T.marca.nombre}. {T.footer.hechoCon}
      </p>
    </div>
  </div>
</footer>
