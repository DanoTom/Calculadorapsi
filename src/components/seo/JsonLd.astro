---
/**
 * Inserta datos estructurados (JSON-LD) para que Google entienda mejor la
 * página. Recibe un objeto y lo serializa en un <script type="application/ld+json">.
 */
interface Props {
  schema: Record<string, unknown>;
}
const { schema } = Astro.props;
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
