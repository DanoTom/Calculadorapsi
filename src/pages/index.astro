---
import Base from '../layouts/Base.astro';
import Calculadora from '../components/Calculadora/Calculadora.svelte';
import AdSlot from '../components/ads/AdSlot.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import { T } from '../lib/strings';
import { SITE } from '../../site.config';
import { getCollection } from 'astro:content';

// Guías publicadas (en desarrollo se ven todas; en producción solo las no-borrador)
const todas = await getCollection('guias');
const publicadas = todas.filter((g) => import.meta.env.DEV || !g.data.draft);
const destacadas = publicadas.sort((a, b) => a.data.orden - b.data.orden).slice(0, 3);

// Datos estructurados para Google
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: SITE.name,
  url: SITE.url,
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Web',
  description: SITE.description,
  inLanguage: 'es',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---

<Base>
  <JsonLd schema={schema} slot="head" />

  <!-- HERO -->
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0 -z-10"
      style="background: radial-gradient(60% 50% at 50% 0%, #f6efe5 0%, #fcf9f4 70%);"
    >
    </div>
    <div class="contenedor pt-14 pb-10 text-center sm:pt-20 sm:pb-14">
      <p
        class="mx-auto inline-flex items-center gap-2 rounded-full border border-crema-200 bg-crema-50 px-4 py-1.5 text-sm font-medium text-tinta-600"
      >
        <span class="inline-block h-2 w-2 rounded-full bg-salvia-500"></span>
        Para psicólogos y terapeutas de Latinoamérica
      </p>

      <h1 class="mx-auto mt-6 max-w-3xl text-4xl font-semibold text-balance sm:text-5xl md:text-6xl">
        {T.hero.titulo}
      </h1>

      <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-tinta-600 text-pretty">
        {T.hero.subtitulo}
      </p>

      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href="#calculadora"
          class="w-full rounded-2xl bg-terracota-600 px-7 py-3.5 text-base font-semibold text-crema-50 shadow-suave transition-colors hover:bg-terracota-700 sm:w-auto"
        >
          {T.hero.cta}
        </a>
        <a
          href="#como-funciona"
          class="w-full rounded-2xl border border-crema-200 bg-crema-50 px-7 py-3.5 text-base font-semibold text-tinta-800 transition-colors hover:bg-crema-100 sm:w-auto"
        >
          {T.hero.ctaSecundaria}
        </a>
      </div>

      <div class="mt-6 flex flex-wrap items-center justify-center gap-x-3 gap-y-2 text-sm">
        {
          T.hero.ventajas.map((v) => (
            <span
              class:list={[
                'inline-flex items-center gap-1.5 rounded-full px-3 py-1',
                v.fuerte ? 'bg-salvia-50 font-semibold text-salvia-700' : 'text-tinta-600',
              ]}
            >
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <polyline points="20 6 9 17 4 12" />
              </svg>
              {v.texto}
            </span>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CALCULADORA (isla interactiva) -->
  <section id="calculadora" class="scroll-mt-20">
    <div class="contenedor max-w-6xl">
      <div class="mb-6 text-center">
        <h2 class="text-3xl font-semibold sm:text-4xl">Tu calculadora</h2>
        <p class="mx-auto mt-2 max-w-xl text-tinta-600">
          Cargá tus números y mirá los resultados al instante. Arranca con un ejemplo: cambialo por
          lo tuyo.
        </p>
      </div>
      <Calculadora client:visible />
    </div>
  </section>

  <!-- VALOR: tres números -->
  <section class="contenedor mt-20 max-w-5xl">
    <h2 class="text-center text-3xl font-semibold sm:text-4xl">{T.valor.titulo}</h2>
    <div class="mt-10 grid gap-5 md:grid-cols-3">
      {
        T.valor.items.map((item, i) => (
          <div class="rounded-3xl border border-crema-200 bg-white p-6 shadow-suave">
            <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-crema-100 font-display text-lg font-semibold text-terracota-600">
              {i + 1}
            </div>
            <h3 class="mt-4 text-xl font-semibold">{item.titulo}</h3>
            <p class="mt-2 leading-relaxed text-tinta-600">{item.texto}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Espacio publicitario (reservado, desactivado hasta aprobar AdSense) -->
  <div class="contenedor mt-16">
    <AdSlot minHeight="100px" />
  </div>

  <!-- CÓMO FUNCIONA -->
  <section id="como-funciona" class="scroll-mt-20 bg-crema-100/50 py-16">
    <div class="contenedor max-w-5xl">
      <h2 class="text-center text-3xl font-semibold sm:text-4xl">{T.comoFunciona.titulo}</h2>
      <ol class="mt-10 grid gap-6 md:grid-cols-3">
        {
          T.comoFunciona.pasos.map((paso, i) => (
            <li class="relative">
              <span class="font-display text-5xl font-semibold text-crema-300">0{i + 1}</span>
              <h3 class="mt-2 text-xl font-semibold">{paso.titulo}</h3>
              <p class="mt-2 leading-relaxed text-tinta-600">{paso.texto}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- GUÍAS DESTACADAS -->
  {
    destacadas.length > 0 && (
      <section class="contenedor mt-20 max-w-5xl">
        <div class="flex items-end justify-between gap-4">
          <div>
            <h2 class="text-3xl font-semibold sm:text-4xl">{T.guias.titulo}</h2>
            <p class="mt-2 max-w-xl text-tinta-600">{T.guias.subtitulo}</p>
          </div>
          <a
            href="/guias"
            class="hidden shrink-0 rounded-xl border border-crema-200 bg-crema-50 px-4 py-2 text-sm font-semibold text-tinta-800 transition-colors hover:bg-crema-100 sm:inline-block"
          >
            Ver todas
          </a>
        </div>
        <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {destacadas.map((g) => (
            <a
              href={`/guias/${g.id}`}
              class="group flex flex-col rounded-3xl border border-crema-200 bg-white p-6 shadow-suave transition-shadow hover:shadow-tarjeta"
            >
              {g.data.pais && (
                <span class="mb-3 inline-flex w-fit rounded-full bg-crema-100 px-3 py-1 text-xs font-semibold text-tinta-600">
                  {g.data.pais}
                </span>
              )}
              <h3 class="text-lg font-semibold leading-snug group-hover:text-terracota-600">
                {g.data.title}
              </h3>
              <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-tinta-600">
                {g.data.description}
              </p>
              <span class="mt-4 text-sm font-semibold text-terracota-600">{T.guias.leerMas} →</span>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <!-- DISCLAIMER -->
  <section class="contenedor mt-16 max-w-3xl">
    <p class="rounded-2xl border border-crema-200 bg-crema-100/60 px-5 py-4 text-center text-sm leading-relaxed text-tinta-600">
      {T.disclaimer}
    </p>
  </section>
</Base>
