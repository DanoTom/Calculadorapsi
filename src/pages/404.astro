---
import Base from '../layouts/Base.astro';
import { T } from '../lib/strings';
---

<Base title="Página no encontrada" noindex={true}>
  <section class="contenedor flex min-h-[60vh] flex-col items-center justify-center py-16 text-center">
    <p class="font-display text-7xl font-semibold text-crema-300">404</p>
    <h1 class="mt-4 text-3xl font-semibold">{T.error404.titulo}</h1>
    <p class="mt-3 max-w-md text-tinta-600">{T.error404.texto}</p>
    <a
      href="/"
      class="mt-8 rounded-2xl bg-terracota-500 px-6 py-3 text-base font-semibold text-crema-50 shadow-suave transition-colors hover:bg-terracota-600"
    >
      {T.error404.volver}
    </a>
  </section>
</Base>
