---
import Base from '../../layouts/Base.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import AdSlot from '../../components/ads/AdSlot.astro';
import { getCollection, render } from 'astro:content';
import { SITE } from '../../../site.config';
import { T } from '../../lib/strings';

export async function getStaticPaths() {
  const todas = await getCollection('guias');
  const guias = todas.filter((g) => import.meta.env.DEV || !g.data.draft);
  return guias.map((g) => ({ params: { slug: g.id }, props: { guia: g } }));
}

const { guia } = Astro.props;
const { Content } = await render(guia);

const fecha = guia.data.actualizado ?? guia.data.pubDate;
const fechaLegible = fecha.toLocaleDateString('es-AR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: guia.data.title,
  description: guia.data.description,
  datePublished: guia.data.pubDate.toISOString(),
  dateModified: fecha.toISOString(),
  inLanguage: 'es',
  author: guia.data.author
    ? {
        '@type': 'Person',
        name: guia.data.author,
        // Conecta al autor con su página y su perfil público (señal de autoría real)
        ...(guia.data.author === SITE.author
          ? { url: `${SITE.url}/sobre`, sameAs: [SITE.authorLinkedIn] }
          : {}),
      }
    : { '@type': 'Organization', name: SITE.name },
  publisher: { '@type': 'Organization', name: SITE.name },
};

// Migas de pan para Google (Inicio → Guías → esta guía)
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Guías', item: `${SITE.url}/guias` },
    { '@type': 'ListItem', position: 3, name: guia.data.title },
  ],
};

// Guías relacionadas: por tags en común y mismo país. Enlazado interno
// automático — ayuda al lector a seguir leyendo y a Google a descubrir.
const todasLasGuias = (await getCollection('guias')).filter(
  (g) => g.id !== guia.id && (import.meta.env.DEV || !g.data.draft)
);
const relacionadas = todasLasGuias
  .map((g) => {
    let puntos = g.data.tags.filter((t) => guia.data.tags.includes(t)).length;
    if (guia.data.pais && g.data.pais === guia.data.pais) puntos += 2;
    return { guia: g, puntos };
  })
  .sort((a, b) => b.puntos - a.puntos || a.guia.data.orden - b.guia.data.orden)
  .slice(0, 3)
  .map((x) => x.guia);

// Schema de preguntas frecuentes (si la guía las define en el frontmatter).
// Permite que Google muestre las preguntas desplegables en la búsqueda.
const faq = guia.data.faq ?? [];
const faqSchema =
  faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faq.map((item) => ({
          '@type': 'Question',
          name: item.pregunta,
          acceptedAnswer: { '@type': 'Answer', text: item.respuesta },
        })),
      }
    : null;
---

<Base title={guia.data.title} description={guia.data.description} type="article">
  <JsonLd schema={schema} slot="head" />
  <JsonLd schema={breadcrumbSchema} slot="head" />
  {faqSchema && <JsonLd schema={faqSchema} slot="head" />}

  <article class="contenedor py-12">
    <a href="/guias" class="text-sm font-medium text-terracota-600 hover:text-terracota-700">
      ← {T.guias.volver}
    </a>

    <header class="mx-auto mt-6 max-w-2xl">
      {
        guia.data.pais && (
          <span class="inline-flex rounded-full bg-crema-100 px-3 py-1 text-xs font-semibold text-tinta-600">
            {guia.data.pais}
          </span>
        )
      }
      <h1 class="mt-4 text-4xl font-semibold leading-tight">{guia.data.title}</h1>
      <p class="mt-4 text-lg text-tinta-600">{guia.data.description}</p>
      <p class="mt-4 text-sm text-tinta-500">
        {
          guia.data.author && (
            <>
              Por{' '}
              <a href="/sobre" class="font-medium text-tinta-700 underline underline-offset-2 hover:text-terracota-600">
                {guia.data.author}
              </a>{' '}
              ·{' '}
            </>
          )
        }{fechaLegible} · {guia.data.tiempoLectura}
        {' '}{T.guias.tiempoLectura}
      </p>
    </header>

    <div class="prosa mt-10">
      <Content />
    </div>

    {
      faq.length > 0 && (
        <section class="prosa mt-12">
          <h2>Preguntas frecuentes</h2>
          <div class="not-prose mt-4 space-y-3">
            {faq.map((item) => (
              <details class="group rounded-2xl border border-crema-200 bg-white p-4 sm:p-5">
                <summary class="flex cursor-pointer items-center justify-between gap-3 font-display font-semibold text-tinta-900 marker:content-['']">
                  {item.pregunta}
                  <span
                    aria-hidden="true"
                    class="shrink-0 text-terracota-600 transition-transform group-open:rotate-45"
                  >
                    +
                  </span>
                </summary>
                <p class="mt-3 leading-relaxed text-tinta-600">{item.respuesta}</p>
              </details>
            ))}
          </div>
        </section>
      )
    }

    <!-- CTA a la calculadora -->
    <div class="mx-auto mt-10 max-w-2xl rounded-2xl border border-crema-200 bg-crema-100/60 p-5 text-center sm:p-6">
      <p class="font-display text-lg font-semibold text-tinta-900">Mirá tu práctica en números</p>
      <p class="mx-auto mt-1 max-w-md text-sm text-tinta-600">
        Gratis y privado. Tu ingreso real por hora y un índice de sostenibilidad, en un minuto.
      </p>
      <a
        href="/#calculadora"
        class="mt-4 inline-block rounded-xl bg-terracota-600 px-5 py-2.5 text-sm font-semibold text-crema-50 shadow-suave transition-colors hover:bg-terracota-700"
      >
        Abrir la calculadora
      </a>
    </div>

    {
      guia.data.tags.length > 0 && (
        <div class="mx-auto mt-8 flex max-w-2xl flex-wrap gap-2">
          {guia.data.tags.map((t) => (
            <span class="rounded-full bg-crema-100 px-3 py-1 text-xs text-tinta-600">#{t}</span>
          ))}
        </div>
      )
    }

    {
      relacionadas.length > 0 && (
        <aside class="mx-auto mt-12 max-w-2xl">
          <h2 class="font-display text-xl font-semibold text-tinta-900">Seguí leyendo</h2>
          <div class="mt-4 grid gap-4 sm:grid-cols-3">
            {relacionadas.map((g) => (
              <a
                href={`/guias/${g.id}`}
                class="group flex flex-col rounded-2xl border border-crema-200 bg-white p-4 shadow-suave transition-shadow hover:shadow-tarjeta"
              >
                {g.data.pais && (
                  <span class="mb-2 inline-flex self-start rounded-full bg-crema-100 px-2.5 py-0.5 text-xs font-semibold text-tinta-600">
                    {g.data.pais}
                  </span>
                )}
                <h3 class="text-sm font-semibold leading-snug group-hover:text-terracota-600">
                  {g.data.title}
                </h3>
                <span class="mt-2 text-xs text-tinta-500">
                  {g.data.tiempoLectura} {T.guias.tiempoLectura}
                </span>
              </a>
            ))}
          </div>
        </aside>
      )
    }

    <div class="mt-12">
      <AdSlot minHeight="100px" />
    </div>

    <p class="prosa mt-10 text-sm text-tinta-500">{T.disclaimer}</p>
  </article>
</Base>
