---
import Base from '../../layouts/Base.astro';
import { T } from '../../lib/strings';
import { getCollection } from 'astro:content';

const todas = await getCollection('guias');
const guias = todas
  .filter((g) => import.meta.env.DEV || !g.data.draft)
  .sort((a, b) => a.data.orden - b.data.orden);
---

<Base title="Guías" description={T.guias.subtitulo}>
  <section class="contenedor py-12">
    <header class="max-w-2xl">
      <h1 class="text-4xl font-semibold sm:text-5xl">{T.guias.titulo}</h1>
      <p class="mt-4 text-lg text-tinta-600">{T.guias.subtitulo}</p>
    </header>

    {
      guias.length > 0 ? (
        <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {guias.map((g) => (
            <a
              href={`/guias/${g.id}`}
              class="group flex flex-col rounded-3xl border border-crema-200 bg-white p-6 shadow-suave transition-shadow hover:shadow-tarjeta"
            >
              <div class="mb-3 flex items-center gap-2">
                {g.data.pais && (
                  <span class="inline-flex rounded-full bg-crema-100 px-3 py-1 text-xs font-semibold text-tinta-600">
                    {g.data.pais}
                  </span>
                )}
                {import.meta.env.DEV && g.data.draft && (
                  <span class="inline-flex rounded-full bg-ambar-50 px-3 py-1 text-xs font-semibold text-ambar-600">
                    Borrador
                  </span>
                )}
              </div>
              <h2 class="text-lg font-semibold leading-snug group-hover:text-terracota-600">
                {g.data.title}
              </h2>
              <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-tinta-600">
                {g.data.description}
              </p>
              <span class="mt-4 flex items-center gap-2 text-sm text-tinta-500">
                {g.data.tiempoLectura} {T.guias.tiempoLectura}
              </span>
            </a>
          ))}
        </div>
      ) : (
        <div class="mt-10 rounded-3xl border border-dashed border-crema-300 bg-crema-50 p-10 text-center">
          <p class="text-lg text-tinta-600">Estamos preparando las primeras guías. Volvé pronto.</p>
        </div>
      )
    }
  </section>
</Base>
